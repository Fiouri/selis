{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Least-privilege permissions for Windows, macOS and Linux. No plugin, fs, shell or network access from the WebView: only the app commands below.",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-import-document",
    "allow-list-documents",
    "allow-read-document",
    "allow-record-document-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-device-memory",
    "allow-pick-pdf",
    "allow-take-result",
    "allow-set-favorite",
    "allow-document-file",
    "allow-save-thumbnail",
    "allow-list-tags",
    "allow-create-tag",
    "allow-rename-tag",
    "allow-delete-tag",
    "allow-set-document-tags",
    "allow-pending-opens",
    "allow-dismiss-open",
    "allow-set-last-page",
    "allow-share-document"
  ]
}
