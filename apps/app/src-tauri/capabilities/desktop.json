{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Least-privilege permissions for Windows, macOS and Linux. No fs/shell/network access from the WebView.",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "dialog:allow-open",
    "allow-import-document",
    "allow-list-documents",
    "allow-read-document",
    "allow-record-document-info",
    "allow-get-settings",
    "allow-update-settings"
  ]
}
