{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Least-privilege permissions for Windows, macOS and Linux. No plugin, fs, shell or network access from the WebView: only the app commands below.",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-import-document",
    "allow-list-documents",
    "allow-read-document",
    "allow-record-document-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-device-memory",
    "allow-pick-pdf",
    "allow-pick-image",
    "allow-take-result",
    "allow-set-favorite",
    "allow-rename-document",
    "allow-delete-document",
    "allow-delete-earlier-versions",
    "allow-upload-chunk",
    "allow-abort-upload",
    "allow-commit-working-copy",
    "allow-working-copy",
    "allow-discard-working-copy",
    "allow-save-version",
    "allow-import-upload",
    "allow-stage-pdf",
    "allow-unstage",
    "allow-list-signatures",
    "allow-save-signature",
    "allow-delete-signature",
    "allow-document-file",
    "allow-save-thumbnail",
    "allow-list-tags",
    "allow-create-tag",
    "allow-rename-tag",
    "allow-delete-tag",
    "allow-set-document-tags",
    "allow-pending-opens",
    "allow-dismiss-open",
    "allow-pending-transfer-link",
    "allow-dismiss-transfer-link",
    "allow-transfer-open",
    "allow-transfer-close",
    "allow-transfer-offer",
    "allow-transfer-send-status",
    "allow-transfer-decide",
    "allow-transfer-cancel-send",
    "allow-transfer-receive",
    "allow-transfer-receive-status",
    "allow-transfer-cancel-receive",
    "allow-transfer-resumable",
    "allow-transfer-resume",
    "allow-transfer-pause",
    "allow-transfer-foreground",
    "allow-transfer-foreground-stop",
    "allow-transfer-debug-force-relay",
    "allow-set-last-page",
    "allow-share-document"
  ]
}
