{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Least-privilege permissions for Android and iOS. No fs/shell/network access from the WebView.",
  "platforms": [
    "android",
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "dialog:allow-open",
    "allow-import-document",
    "allow-list-documents",
    "allow-read-document",
    "allow-record-document-info",
    "allow-get-settings",
    "allow-update-settings"
  ]
}
