{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Least-privilege permissions for Android and iOS. No plugin, fs, shell or network access from the WebView: only the app commands below.",
  "platforms": [
    "android",
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-import-document",
    "allow-list-documents",
    "allow-read-document",
    "allow-record-document-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-device-memory",
    "allow-pick-pdf",
    "allow-take-result"
  ]
}
