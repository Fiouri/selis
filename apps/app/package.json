{
  "name": "@selis/app",
  "version": "1.0.0-rc.4",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "assets": "node ../../scripts/build-scan-wasm.ts && node ../../scripts/copy-ocr-assets.ts",
    "predev:web": "npm run assets",
    "dev:web": "vite",
    "predev:mock": "npm run assets",
    "dev:mock": "vite --mode mock",
    "prebuild:web": "npm run assets",
    "build:web": "tsc -p tsconfig.json && vite build",
    "prebuild:mock": "npm run assets",
    "build:mock": "vite build --mode mock",
    "preview:mock": "vite preview --mode mock --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "e2e": "playwright test",
    "tauri": "node ../../scripts/tauri.ts"
  },
  "dependencies": {
    "@selis/engine": "0.1.0",
    "@selis/ui": "0.1.0",
    "@tanstack/react-query": "5.104.5",
    "@tauri-apps/api": "2.12.4",
    "i18next": "26.5.10",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.4",
    "jsqr": "1.4.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@selis/fixtures": "0.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
